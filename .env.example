# Google AI Studio — Gemini Flash (free tier)
GEMINI_API_KEY=
# NVIDIA NIM — build.nvidia.com (free, no card)
NVIDIA_NIM_API_KEY=

# Groq — console.groq.com (free tier)
GROQ_API_KEY=

# Qdrant running on this machine (see "Start Qdrant locally" in README.md). No API key is needed.
# If QDRANT_URL is empty the app uses a throw-away in-memory store.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# OpenRouter — openrouter.ai (optional bonus lane)
OPENROUTER_API_KEY=

# --- Auto-ingestion drop-folder (optional) ---
# Files placed in data/inbox/ are ingested by the /ingest/folder endpoint or,
# if enabled below, automatically. Content-addressed dedup keeps scans
# idempotent, so files can stay in the folder without creating duplicates.
# Scan the folder once when the server starts:
AUTO_INGEST_ON_STARTUP=false
# Re-scan the folder every N seconds in the background (0 = disabled):
AUTO_INGEST_INTERVAL_SECONDS=0
# --- Text-to-SQL live data (optional) ---
# DB_ENGINE controls which database backend the SQL retrieval stage uses.
# Use "sqlite" for the default local file database, "mysql" for a MySQL server,
# or "postgresql" for a PostgreSQL server.
# DB_ENGINE=sqlite

# Connection details (defaults / fallback). A connection the admin saves in the UI
# (Settings > Database Connection) is stored in config/db_connection.json instead of this
# file and takes precedence over the values below, on any host. If the host's disk is
# ephemeral, set the DB_CONFIG_FILE *environment variable on the host* (not in this file)
# to a path on a persistent volume.
# DB_ENGINE controls which database backend the SQL retrieval stage uses.
# Use "sqlite" for the default local file database, "mysql" for a MySQL server,
# "postgresql" for a PostgreSQL server, "mssql" for SQL Server, or "oracle" for
# Oracle (for "oracle", DB_NAME holds the service name, not a database name).
# DB_ENGINE=sqlite

DB_ENGINE=mysql
# DB_HOST: Database server hostname or IP.
# DB_PORT: Server port: 3306 MySQL, 5432 PostgreSQL, 1433 SQL Server, 1521 Oracle.
# DB_ODBC_DRIVER: SQL Server only. Must match a driver installed on this machine's
# ODBC driver manager (see docs/ODBC_DRIVER_SETUP.md for installation instructions).
# DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_READONLY_USER=
DB_READONLY_PASSWORD=

# =====================================================================
# LOCAL MODELS — embeddings and reranking run on this machine
# (see README.md, "Getting Started"). The defaults below already work; change only if needed.
# Vision (OCR, layout, tables, charts, images, classification), answer generation and
# text-to-SQL stay online and use the API keys above (Gemini first).
# =====================================================================

# Embeddings: BGE-M3 (dense + sparse), downloaded from Hugging Face on first use.
# BGE_M3_MODEL=BAAI/bge-m3
# BGE_M3_MAX_LENGTH=1024
# BGE_M3_BATCH_SIZE=8

# Reranker: bge-reranker-v2-m3. On CPU it is the slowest query step, so rerank fewer chunks:
# BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RETRIEVAL_TOP_K=60
# RERANK_TOP_K=25

# Keep the extracted figure images on disk (data/processed/figures):
# SAVE_FIGURE_IMAGES=true

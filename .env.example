# Google AI Studio — Gemini Flash (free tier)
GEMINI_API_KEY=
# NVIDIA NIM — build.nvidia.com (free, no card)
NVIDIA_NIM_API_KEY=

# Groq — console.groq.com (free tier)
GROQ_API_KEY=

# Qdrant running on this machine (see LOCAL_SETUP.md). No API key is needed.
# If QDRANT_URL is empty the app uses a throw-away in-memory store.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# OpenRouter — openrouter.ai (optional bonus lane)
OPENROUTER_API_KEY=

# --- Auto-ingestion drop-folder (optional) ---
# Files placed in data/inbox/ are ingested by the /ingest/folder endpoint or,
# if enabled below, automatically. Content-addressed dedup keeps scans
# idempotent, so files can stay in the folder without creating duplicates.
# Scan the folder once when the server starts:
AUTO_INGEST_ON_STARTUP=false
# Re-scan the folder every N seconds in the background (0 = disabled):
AUTO_INGEST_INTERVAL_SECONDS=0
# --- Text-to-SQL live data (optional) ---
# DB_ENGINE controls which database backend the SQL retrieval stage uses.
# Use "sqlite" for the default local file database, or "mysql" for a MySQL server.
# DB_ENGINE=sqlite

# MySQL connection details.
DB_ENGINE=mysql
# DB_HOST: MySQL server hostname or IP.  // localhost or 127.0.0.1
# DB_PORT: MySQL port, usually 3306.
# DB_NAME: Database name to query.  // globalmind or any other database name you have used in your local mysql server
# DB_READONLY_USER: A MySQL user with SELECT-only access. //if use local mysql, use root user with no password
# DB_READONLY_PASSWORD: Password for the read-only MySQL user. //leave blank if no password is set for the user.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_READONLY_USER=
DB_READONLY_PASSWORD=

# =====================================================================
# LOCAL MODELS — document ingestion and embeddings run on this machine
# (see LOCAL_SETUP.md). The defaults below already work; change only if needed.
# Answer generation and text-to-SQL still use the API keys above.
# =====================================================================

# Embeddings: BGE-M3 (dense + sparse), downloaded from Hugging Face on first use.
# BGE_M3_MODEL=BAAI/bge-m3
# BGE_M3_MAX_LENGTH=1024
# BGE_M3_BATCH_SIZE=8

# Reranker: bge-reranker-v2-m3. On CPU it is the slowest query step, so rerank fewer chunks:
# BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RETRIEVAL_TOP_K=60
# RERANK_TOP_K=25

# OCR, layout, tables, charts, images and document classification during ingestion:
# Qwen3-VL served by Ollama (OpenAI-compatible API).
# LOCAL_VISION_BASE_URL=http://localhost:11434/v1
# LOCAL_VISION_MODEL=qwen3-vl:4b
# LOCAL_VISION_TIMEOUT_SECONDS=300

# Keep the extracted figure images on disk (data/processed/figures):
# SAVE_FIGURE_IMAGES=true

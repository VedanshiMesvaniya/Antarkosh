# Keep the build context (and image) lean.
.git
.venv
venv
**/__pycache__
**/*.pyc
.pytest_cache
*.bundle

# Docs, dev scripts, evaluations, and the test suite aren't needed in the runtime image.
docs/
scripts/
tests/
evals/
databases/*/evals/

# Node/build tooling — the *built* output in frontend/ is what we ship, not the
# React source or its 100s of MB of node_modules.
Antarkosh_UI/node_modules
node_modules

# Runtime state and learned data — recreated on startup or volume-mounted; never bake into image.
# Note: databases/ curated knowledge packs ARE shipped in the image.
data/
databases/*/learned/
databases/*/learned/*

# Local secrets and runtime connection credentials — provided as environment variables on the host instead.
.env
config/db_connection.json
config/connections.json
config/ingestion.json


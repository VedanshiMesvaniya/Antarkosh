+_LABEL_VISIBLE = re.compile(r"(?im)^[\W_]*VISIBLE\s+TEXT[\W_]*?:[\W_]*")
+_LABEL_MEANING = re.compile(r"(?im)^[\W_]*MEANING[\W_]*?:[\W_]*")
+

+
+class _Adapter:
+    model_id = MODEL
+    vector_dim = 1024
+    supports_sparse = True
+
+    async def embed(self, texts, task="retrieval.passage"):
+        return [[0.0] * 1024 for _ in texts], [SparseVector() for _ in texts]

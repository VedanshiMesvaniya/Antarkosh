+def _file(tmp_path, name="doc.txt", data=b"some document bytes"):
+    f = tmp_path / name
+    f.write_bytes(data)
+    return f
+
+
+def _registry(tmp_path):
+    return IngestionRegistry(registry_path=tmp_path / "registry.json")

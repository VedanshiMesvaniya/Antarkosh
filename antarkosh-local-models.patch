+# ---------------------------------------------------------------------------
+# Pipeline
+# ---------------------------------------------------------------------------
+
+def _pipeline(tmp_path, registry=None):
+    store = AsyncMock()
+    pipe = IngestionPipeline(
+        router=AsyncMock(),
+        embedding_service=EmbeddingService(primary=_Adapter()),
+        vector_store=store,
+        registry=registry or _registry(tmp_path),

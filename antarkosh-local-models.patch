+# ---------------------------------------------------------------------------
+# Local-only routing for document ingestion
+# ---------------------------------------------------------------------------
+
+# Every LLM/vision call made while ingesting a document: OCR, layout, tables,
+# charts, images, and the document-type classifier.
+INGESTION_TASKS = frozenset(_VISION_TASKS | {"semantic_classification"})
+
+
+def local_ingestion_routes() -> dict[str, TaskRoute]:
+    """One-option routes: every ingestion task is served by the local model only."""
+    option = ProviderOption(LOCAL_PROVIDER, settings.local_vision_model, priority=0)
+    return {task: TaskRoute([option]) for task in INGESTION_TASKS}
+
+
+def build_ingestion_router() -> "ProviderRouter":
+    """Router for document ingestion that can only reach the local model.
+
+    Its provider table holds the local server and nothing else, so no ingestion
+    call can fall through to a cloud provider — if the local model fails, the
+    stage logs it and carries on without that content.
+    """
+    router = ProviderRouter(routes=local_ingestion_routes(), preferred_provider="auto")
+    router._providers = {
+        LOCAL_PROVIDER: OpenAICompatibleProvider(
+            name=LOCAL_PROVIDER,
+            base_url=settings.local_vision_base_url.strip(),
+            api_key=settings.local_vision_api_key or "local",
+            rate_limiter=router._rate_limiter,
+            timeout=settings.local_vision_timeout_seconds,
+        )
+    }
+    return router
+
